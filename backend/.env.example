# KANSEI AI — Environment Configuration Template
# NOTE: Replace placeholder values with secure random tokens in production.

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
HOST=127.0.0.1

# Security & Session Secrets (CRITICAL: Use high-entropy random key in production, e.g. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-super-secret-random-hex-key-here

# Database Configuration (SQLite local dev or PostgreSQL connection string)
DATABASE_URL=sqlite:///instance/kansi.db

# Server-Side Session Storage
# Options: 'sqlalchemy' (default for single-node / local dev) or 'redis' (production multi-node cluster)
SESSION_TYPE=sqlalchemy
# If SESSION_TYPE=redis, configure redis connection URI:
# SESSION_REDIS=redis://localhost:6379/1

# CORS Allowed Origins (Comma-separated exact origins, never wildcard '*' with credentials enabled)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting Storage (memory:// for local dev, redis://localhost:6379/0 for production clustering)
RATELIMIT_STORAGE_URI=memory://

# Production Deployment Guidelines:
# - Set FLASK_ENV=production
# - Set FLASK_DEBUG=False
# - Ensure HTTPS is enforced via reverse proxy (Nginx/Cloudflare)
# - Use a dedicated key-value store (e.g., Redis cluster) with SESSION_TYPE=redis for horizontal scaling
# - SESSION_COOKIE_SECURE automatically activates to enforce SSL/TLS cookie transmission
# - SESSION_COOKIE_HTTPONLY is locked to True to mitigate XSS session hijacking
# - SESSION_COOKIE_SAMESITE is set to 'Lax' for CSRF defense
